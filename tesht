#!/usr/bin/env bash

# Naming Policy:
#
# All function and variable names are camelCased.
#
# Private function names begin with lowercase letters.
# Public function names begin with uppercase letters.
# Function names are prefixed with "tesht." (always lowercase) so they are namespaced.
#
# Local variable names begin with lowercase letters, e.g. localVariable.
#
# Global variable names begin with uppercase letters, e.g. GlobalVariable.
# Global variable names are also namespaced by suffixing them with
# the randomly-generated letter T, e.g. GlobalVariableT.
#
# Variable declarations that are name references borrow the environment namespace, e.g.
# "local -n ARRAY=$1".

IFS=$'\n'
set -o noglob
NL=$'\n'

Prog=$(basename "$0")   # match what the user called

read -rd '' Usage_ <<END
Usage:

  $Prog [OPTIONS] [--] [FILE...]

  Options:

    --run REGEXP        filter test names by bash native regex (=~)
                        (also --run=REGEXP; empty regex matches all tests)
    -j N | --jobs N     run up to N tests concurrently within each file
                        (also -jN and --jobs=N; default: 1 = serial)
    -p N | --file-jobs N  run up to N test files concurrently
                        (also -pN and --file-jobs=N; default: 1 = serial;
                        output stays in file order; composes with -j)
    -h | --help         show this message and exit
    -x | --trace        enable debug tracing
    --                  stop option processing

  Arguments:

    FILE...             run tests from the specified file(s) or directories
                        (directories expand to *_test.bash, one level deep)
                        (if none given, runs all *_test.bash files in cwd)

  Examples:

    $Prog                              # run all tests in all *_test.bash files
    $Prog my_test.bash                 # run tests in one file
    $Prog foo_test.bash bar_test.bash  # multiple files
    $Prog scripts/                     # all *_test.bash in scripts/ (shallow)
    $Prog --run TestMyFunction         # filter by name regex (any file)
    $Prog my_test.bash --run TestFoo   # file + name filter
    $Prog --run=TestFoo my_test.bash   # equals-syntax variant
    $Prog -j 4 my_test.bash            # run 4 tests in parallel within the file
    $Prog -j "\$(nproc)"                # one worker per CPU

  Options follow POSIX/GNU syntax and may appear before or after FILE
  arguments.

  Environment:

    TESHT_NO_SKIP=1     run tests that call tesht.Skip instead of skipping them
END

GreenT=$'\033[38;5;82m'
RedT=$'\033[38;5;196m'
YellowT=$'\033[38;5;220m'

ResetT=$'\033[0m'

FailT=${RedT}FAIL$ResetT
FatalT=${RedT}FATAL$ResetT
PassT=${GreenT}PASS$ResetT
SkipT=${YellowT}SKIP$ResetT
RunT=${YellowT}RUN$ResetT

UnixMilliFuncT=tesht.UnixMilli

# tesht.Main runs any test functions in the files given as arguments.
# It outputs success or failure.
#
# Args: $1 = test-name regex filter (empty = match all);
#       $2 = newline-separated list of test files (typically built via tesht.ListOf);
#       $3 = within-file parallelism (default 1 = serial; -j N flag, #37833);
#       $4 = cross-file parallelism (default 1 = serial; -p N flag).
tesht.Main() {
  local runRegexp_=${1:-} filenames=( ${2:-} )
  local -i jobs=${3:-1} fileJobs=${4:-1}

  local -i PassCountT=0 TestCountT=0 SkipCountT=0 failed=0   # -i enables arithmetic operations
  local -i startTime=$($UnixMilliFuncT)

  if (( fileJobs <= 1 || ${#filenames[@]} <= 1 )); then
    for filename in "${filenames[@]}"; do
      tesht.testFile $filename "$runRegexp_" $jobs || failed=1
    done
  else
    tesht.testFiles "$runRegexp_" $jobs $fileJobs "${filenames[@]}" || failed=1
  fi

  (( TestCountT > 0 || SkipCountT > 0 )) || failed=2

  local -i endTime=$($UnixMilliFuncT)
  local duration=$(( endTime - startTime ))ms

  local columns='%s\t\t%s\n'
  (( failed )) && local result=$FailT || local result=$PassT
  if (( SkipCountT > 0 )); then
    printf '%s\t\t%s\t(%d skipped)\n' $result $duration $SkipCountT
  else
    printf $columns $result $duration
  fi

  echo $PassCountT/$TestCountT
  return $failed
}

# tesht.failFlag signals a mid-body assertion failure to the test runner
# (#25287). Bash suppresses set -e inside functions invoked from && || compound
# lists, so a returning rc=0 from the function's last command would silently
# pass when an earlier assertion failed. Helpers call this to raise a sentinel
# the runner checks after the test/subtest body returns.
#
# The PID gate (BASHPID == TESHT_FAIL_FLAG_PID) scopes the flag to the
# test/subtest's own subshell: an assertion intentionally exercised inside a
# nested $(...) or (...) -- e.g. helper self-tests that capture the helper's
# failure output -- runs at a different BASHPID and does not taint the outer
# verdict.
# shellcheck disable=SC9003 # test-callable helper: runs under the calling test file's IFS, so it quotes defensively (library role)
tesht.failFlag() {
  [[ -z ${TESHT_FAIL_FLAG:-} ]] && return
  [[ ${TESHT_FAIL_FLAG_PID:-} == "$BASHPID" ]] || return
  touch "$TESHT_FAIL_FLAG"
}

# tesht.AssertGot returns whether the items match and, if not, outputs a message.
tesht.AssertGot() {
  local gotLines=$1 wantLines=${2:-}

  [[ $gotLines == "$wantLines" ]] && return

  tesht.failFlag

  cat <<END


got does not match want:
$(tesht.Diff "$gotLines" "$wantLines")

use this line to update want to match:
    want=${gotLines@Q}

END

  return 1
}

# tesht.AssertRC compares return codes and reports if they don't match.
tesht.AssertRC() {
  local rc=$1 wantrc=$2

  (( rc == wantrc )) && return
  tesht.failFlag
  tesht.Log "error: rc = $rc, want: $wantrc"
  return 1
}

# tesht.declareVar returns a declaration for a variable, handling arrays if the name is plural.
tesht.declareVar() {
  local name=$1 value=$2
  [[ ($name == *s || $name == *s_) && $value == '('*')' ]] &&
    echo "declare -a $name=${value@Q}" ||
    echo "declare $name=${value@Q}"
}

# tesht.Defer schedules a command to run on EXIT, preserving any existing EXIT trap.
# Best-effort by design: the command runs under `|| true` so a Defer'd cleanup
# command that legitimately fails on a redundant/second invocation (e.g. `kill`
# on an already-reaped PID, `mv` on a path already restored inline) cannot abort
# the accumulated EXIT trap under `set -e` and corrupt an already-passing
# test's reported verdict (tesht #67543).
tesht.Defer() {
  local command=$1
  local NL=$'\n' # newline works with backgrounding (&) and legal semicolons, semicolon doesn't
  trap "{ TESHT_IN_DEFER=1; $command; } || true$NL$(tesht.existingDeferlist)" EXIT
}

# tesht.Diff returns a diff of its arguments with special characters shown by cat.
# It is a test helper to generate failed assertion output.
tesht.Diff() {
  local gotLines=$1 wantLines=$2
  diff <(echo "$gotLines") <(echo "$wantLines") | cat -vT | tail -n +2
}

# tesht.existingDeferlist returns the current EXIT trap command without the trap wrapper.
tesht.existingDeferlist() {
  local deferlist_=$(trap -p EXIT)
  deferlist_=${deferlist_#trap -- \'}
  deferlist_=${deferlist_%\' EXIT}
  echo "$deferlist_"
}

# tesht.Inherit returns an eval'able set of variable assignments from a map.
# The map is an associative array variable in the outer scope named by mapname.
# It is a test helper that makes it simple to work with the keys of the testmap.
# Inspired by nix's inherit keyword.
# shellcheck disable=SC9003 # test-callable helper: runs under the calling test file's IFS, so it quotes defensively (library role)
tesht.Inherit() {
  local MAPNAME=$1
  local -n MAP=$MAPNAME

  local KEY
  for KEY in ${!MAP[*]}; do
    tesht.declareVar $KEY "${MAP[$KEY]}"
  done
}

# tesht.ListOf joins its arguments with newlines.
tesht.ListOf() {
  local IFS=$'\n'
  echo "$*"
}

# tesht.listTestnames lists the name of any functions in $1.
# Valid function names begin the line with "test_",
# followed by identifier characters and "()".
tesht.listTestnames() {
  awk '/^test_[-_.a-zA-Z0-9]+()/ { sub(/\(.*/, "", $1); print $1 }' $1
}

tesht.Log() {
  local IFS=$NL
  echo "$NL$NL$*"
}

# tesht.MktempDir makes a temporary directory and sets the reference variable to the directory name.
# It returns an error if it cannot make the directory.
tesht.MktempDir() {
  local -n DIR=$1
  DIR=$(mktemp -d /tmp/tesht.XXXXXX) || { echo 'could not create temporary directory'; return 1; }

  [[ $DIR == /*/* ]] || { echo 'temporary directory does not comply with naming requirements'; return 1; }

  [[ -d $DIR ]] || { echo 'temporary directory was made but does not exist now'; return 1; }

  tesht.Defer "tesht.Retry --attempts 5 --delay 0.2 --on-exhaust warn -- rm -rf -- $DIR"
}

# tesht.Retry runs CMD up to N times, returning 0 on first success. It is a
# composable middleware in the fluentfp/web Adapt(handler, opts...) style:
# options are long-flag pairs consumed before the wrapped command, then the
# command + its args follow (optionally separated by `--`).
#
# Options:
#   --attempts N      number of attempts (default 5; must be a positive integer)
#   --delay SEC       sleep between attempts (default 0.2; fractional seconds OK)
#   --on-exhaust MODE behavior after attempts are exhausted (default fail):
#                       fail   -> return 1
#                       warn   -> log to stderr + return 0
#                       silent -> return 0
#
# Designed for the cleanup-race case in tesht.MktempDir (#37012): a forked
# child still writing into a tmpdir at EXIT-trap time races rm -rf and fails
# with ENOTEMPTY. The MktempDir Defer uses --on-exhaust warn so the test's
# assertion verdict survives a cleanup miss. Reusable for any retry-with-policy
# composition without growing per-call wrappers.
tesht.Retry() {
  local -i attempts=5
  local delay=0.2
  local onExhaust=fail
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --attempts)   attempts=$2; shift 2;;
      --delay)      delay=$2; shift 2;;
      --on-exhaust) onExhaust=$2; shift 2;;
      --)           shift; break;;
      *)            echo "tesht.Retry: unknown option: $1" >&2; return 2;;
    esac
  done
  (( $# > 0 )) || { echo 'tesht.Retry: missing command after options' >&2; return 2; }

  local -i attempt
  for (( attempt = 1; attempt <= attempts; attempt++ )); do
    "$@" 2>/dev/null && return 0
    sleep $delay
  done

  case $onExhaust in
    fail)   return 1;;
    warn)   echo "warning: tesht.Retry: $attempts attempts exhausted: $*" >&2; return 0;;
    silent) return 0;;
    *)      echo "tesht.Retry: unknown --on-exhaust: $onExhaust" >&2; return 2;;
  esac
}

# tesht.portIsInUse detects whether port is already in use.
tesht.portIsInUse() {
  local pidList rc
  command -v lsof &>/dev/null && {
    pidList=$(lsof -tiTCP:$port -sTCP:LISTEN) && rc=$? || rc=$?
    (( rc == 0 )) && echo "http server port $port is taken by pid $pidList"
    return $rc
  }

  command -v ss &>/dev/null && {
    ss -tuln | grep -q ":$port\b" && rc=$? || rc=$?
    (( rc == 0 )) && echo "http server port $port is taken"
    return $rc
  }

  netstat -an | grep -qE "(:$port\s+).*LISTEN" && rc=$? || rc=$?
  (( rc == 0 )) && echo "http server port $port is taken"
  return $rc
}

# tesht.Run runs tesht.runSubtest on each test case.
# shellcheck disable=SC9003 # test-callable helper: runs under the calling test file's IFS, so it quotes defensively (library role)
tesht.Run() {
  local FAILED=0 CASENAME
  for CASENAME in "$@"; do
    tesht.runSubtest "${FUNCNAME[1]}" "$CASENAME" || {
      (( $? == 128 )) && return 128 # fatal
      FAILED=1
    }
  done

  return $FAILED
}

# tesht.runSubtest runs the function `subtest` with mapname as an argument.
# mapname is the name of an associative array in an outer scope
# holding at least the key "name".
# It outputs success or failure.
# It returns an error result code if there was failure.
# It cannot wholly rely on the global namespace for tesht functions/variables
# because it runs in the context of a test, so be careful.
# shellcheck disable=SC9003 # test-callable helper: runs under the calling test file's IFS, so it quotes defensively (library role)
tesht.runSubtest() {
  local testname=$1 mapname=$2

  local -n map=$mapname
  local testname=$testname/${map[name]}

  local columns='=== %s\t\t\t%s'
  printf $columns $RunT $testname

  local -i startTime=$($UnixMilliFuncT)
  local rc
  # Each subtest removes its own flags once judged (below), so a fail-flag
  # present here was raised by the test body before or between subtests: keep
  # it in the sticky marker, which tesht.test checks, before clearing it.
  if [[ -n ${TESHT_FAIL_FLAG:-} ]]; then
    [[ -e $TESHT_FAIL_FLAG ]] && touch "$TESHT_FAIL_FLAG.sticky"
    rm -f "$TESHT_FAIL_FLAG" "${TESHT_SKIP_FLAG:-}"
  fi
  # TESHT_FAIL_FLAG_PID scopes the flags to this subshell: helpers called
  # directly in the subtest body raise them, ones inside nested $(...) do not.
  ( TESHT_FAIL_FLAG_PID=$BASHPID; TESHT_IN_SUBTEST=1; subtest $mapname ) && rc=$? || rc=$?
  # FAIL wins over SKIP; set -e is suppressed by the && || invocation shape.
  local -i skipped=0
  local reason_=''
  if [[ -n ${TESHT_FAIL_FLAG:-} ]]; then
    (( rc == 0 )) && [[ -e $TESHT_FAIL_FLAG ]] && rc=1
    if (( rc == 0 )) && [[ -e ${TESHT_SKIP_FLAG:-} ]]; then
      skipped=1
      reason_=$(<"$TESHT_SKIP_FLAG")
    fi
    rm -f "$TESHT_FAIL_FLAG" "${TESHT_SKIP_FLAG:-}"
  fi
  local -i endTime=$($UnixMilliFuncT)
  local duration=$(( endTime - startTime ))ms

  # Counts go to the per-test count file as each subtest finishes, so a later
  # exit in the test body cannot lose them; the caller's counters gate a late
  # test-level tesht.Skip.
  columns='\r--- %s\t%s\t%s\n'
  local delta='1 0 0'
  if (( skipped )); then
    printf '\r--- %s\t%s\t%s: %s\n' "$SkipT" "$duration" "$testname" "$reason_"
    subtestSkipCount+=1   # in caller's scope
    delta='0 0 1'
  else
    subtestTestCount+=1   # in caller's scope
    case $rc in
      0   )
        printf "$columns" "$PassT" "$duration" "$testname"
        subtestPassCount+=1   # in caller's scope
        delta='1 1 0'
        ;;
      128 ) printf "$columns" "$FatalT" "$duration" "$YellowT$testname$ResetT";;

      *   ) printf "$columns" "$FailT" "$duration" "$YellowT$testname$ResetT";;
    esac
  fi
  [[ -z ${TESHT_COUNT_FILE:-} ]] || echo $delta >>"$TESHT_COUNT_FILE"

  return $rc
}

# tesht.Smoke runs a command and asserts its exit code matches the expected value.
# Use for ad-hoc CLI smoke checks outside test functions, where naive shell
# chains propagate the last command's exit code -- producing a script-level
# nonzero even when an intentional-failure path was being verified. tesht.Smoke
# inverts that: nonzero from the command is success when expected, and the
# helper returns 0; mismatches return 1 with the actual rc and captured output
# on stderr.
#
# Usage: tesht.Smoke EXPECTED_RC -- CMD [ARGS...]
#        tesht.Smoke EXPECTED_RC CMD [ARGS...]   # -- optional
tesht.Smoke() {
  local want=$1; shift
  [[ ${1:-} == -- ]] && shift
  local got_ rc=0
  got_=$("$@" 2>&1) || rc=$?
  (( rc == want )) && return 0
  tesht.failFlag
  tesht.Log "FAIL: expected rc=$want, got rc=$rc from: $*"
  tesht.Log "  output: $got_"
  return 1
}

# tesht.Softly runs assertions provided on stdin and reports whether any failed.
# shellcheck disable=SC9003 # test-callable helper: runs under the calling test file's IFS, so it quotes defensively (library role)
tesht.Softly() {
  local FAILED=0 LINE=''  # don't mask higher namespaces
  while IFS='' read -r LINE; do
    eval "$LINE" || FAILED=1
  done
  return $FAILED
}

# tesht.Skip stops the current test or subtest and reports it as skipped with
# `reason`, unless that would hide something or cannot work from here.
#
# The reason has newlines and carriage returns folded to spaces and every run
# of three or more dashes printed as "--", so a SKIP line never contains
# "--- FAIL". The skip is refused -- a stderr warning, return 0, and the body
# carries on -- when TESHT_NO_SKIP=1, outside a running test, inside a
# tesht.Defer cleanup, outside the test's own shell (e.g. in $(...)), or at
# test level after any subtest has run. Otherwise it records the reason in
# the per-test skip-flag and exits the test's or subtest's subshell.
# shellcheck disable=SC9003 # test-callable helper: runs under the calling test file's IFS, so it quotes defensively (library role)
tesht.Skip() {
  local reason_=${1:-}
  reason_=${reason_//$'\n'/ }
  reason_=${reason_//$'\r'/ }
  while [[ $reason_ == *---* ]]; do reason_=${reason_//---/--}; done

  local why_=''
  if [[ ${TESHT_NO_SKIP:-} == 1 ]]; then
    why_='TESHT_NO_SKIP=1'
  elif [[ -z ${TESHT_SKIP_FLAG:-} ]]; then
    why_='no test is running'
  elif [[ ${TESHT_IN_DEFER:-} == 1 ]]; then
    why_='inside a tesht.Defer cleanup'
  elif [[ ${TESHT_FAIL_FLAG_PID:-} != "$BASHPID" ]]; then
    why_="not in the test's own shell"
  elif [[ -z ${TESHT_IN_SUBTEST:-} ]] && (( ${subtestTestCount:-0} + ${subtestSkipCount:-0} > 0 )); then
    why_='its subtests already ran'
  fi
  if [[ -n $why_ ]]; then
    echo "tesht.Skip: ignored ($why_): $reason_" >&2
    return 0
  fi

  printf '%s' "$reason_" >"$TESHT_SKIP_FLAG"
  exit 0
}

# tesht.StartHttpServer starts an http server in the current directory on 127.0.0.1:port.
# It waits until the server is ready before returning.
#
# Security note: serves the ENTIRE current working directory for the
# server's lifetime, localhost-only (127.0.0.1, not network-exposed) but
# with no file-level scoping or allowlist -- any other local process on
# the machine can fetch anything under the caller's cwd while the server
# runs. Callers testing against a subdirectory should `cd` there first
# rather than relying on any implicit scoping (there is none).
tesht.StartHttpServer() {
  local port=${1:-8000}

  tesht.portIsInUse $port && return 1

  # start the http server, redirect stdout so it doesn't hang
  local -i pid
  pid=$(python3 -m http.server $port --bind 127.0.0.1 &>/dev/null & echo $!)
  (( pid != 0 )) || { echo 'could not start http server'; return 1; }

  for duration in 0.1 0.2 0.4 0.8; do
    sleep $duration
    curl http://127.0.0.1:$port &>/dev/null && rc=$? || rc=$?
    (( rc == 0 )) && break
  done

  (( rc == 0 )) && echo $pid || echo 'could not connect to http server'

  return $rc
}

# tesht.test tests the named function.
tesht.test() {
  local testSource_=$1 testname=$2

  local -i startTime=$($UnixMilliFuncT)

  # Per-test sentinels: assertion helpers touch the fail-flag, tesht.Skip
  # writes the skip-flag, runSubtest appends to the count file and keeps
  # test-level failures in the sticky marker. All are judged here, outside the
  # test's subshell, so an exit in the body cannot bypass them. They are saved
  # and restored, so a nested run cannot disarm the outer test.
  local prevFail_=${TESHT_FAIL_FLAG-} prevSkip_=${TESHT_SKIP_FLAG-} prevCount_=${TESHT_COUNT_FILE-}
  local failflag_
  failflag_=$(mktemp -u /tmp/tesht.failflag.XXXXXX)
  export TESHT_FAIL_FLAG=$failflag_
  export TESHT_SKIP_FLAG=$failflag_.skip
  export TESHT_COUNT_FILE=$failflag_.count
  local -i hasSubtests=0 subtestTestCount=0 subtestPassCount=0 subtestSkipCount=0
  (
    TESHT_FAIL_FLAG_PID=$BASHPID
    TESHT_IN_SUBTEST=
    eval "$testSource_"

    [[ $(declare -f $testname) == *tesht.Run* ]] && hasSubtests=1
    (( hasSubtests )) && : >$TESHT_COUNT_FILE

    local columns='=== %s\t\t\t%s'
    (( hasSubtests )) || printf $columns $RunT $testname

    $testname && rc=$? || rc=$?
    exit $rc
  ) && rc=$? || rc=$?

  local -i failNow=0 skipNow=0 tested=0 passed=0 skippedSubs=0 a b c
  local reason_=''
  [[ -e $failflag_ || -e $failflag_.sticky ]] && failNow=1
  if [[ -e $failflag_.skip ]]; then
    skipNow=1
    reason_=$(<"$failflag_.skip")
  fi
  if [[ -e $failflag_.count ]]; then
    hasSubtests=1
    while IFS=' ' read -r a b c; do
      tested+=a; passed+=b; skippedSubs+=c
    done <"$failflag_.count"
  fi
  rm -f "$failflag_" "$failflag_.skip" "$failflag_.sticky" "$failflag_.count"
  [[ -n $prevFail_ ]] && export TESHT_FAIL_FLAG=$prevFail_ || unset TESHT_FAIL_FLAG
  [[ -n $prevSkip_ ]] && export TESHT_SKIP_FLAG=$prevSkip_ || unset TESHT_SKIP_FLAG
  [[ -n $prevCount_ ]] && export TESHT_COUNT_FILE=$prevCount_ || unset TESHT_COUNT_FILE

  local -i endTime=$($UnixMilliFuncT)
  local duration=$(( endTime - startTime ))ms
  local columns='\r--- %s\t%s\t%s\n'

  # A test that skipped itself before any subtest ran is a plain skip.
  if (( hasSubtests )) && ! (( tested + skippedSubs == 0 && skipNow )); then
    TestCountT+=$tested
    PassCountT+=$passed
    SkipCountT+=$skippedSubs

    # A failure recorded at test level (before, between or after subtests),
    # or a nonzero rc no subtest explains, gets its own line and count, so
    # P/T and FAIL-line readers see it too; rc 128 there is FATAL.
    if (( failNow || (rc != 0 && passed == tested) )); then
      local label=$FailT
      (( rc == 128 && ! failNow )) && label=$FatalT
      printf $columns $label $duration $YellowT$testname$ResetT
      TestCountT+=1
      failed=1
    fi
    # Subtest failures fail the test whatever its last command returned.
    (( passed < tested || rc != 0 )) && failed=1
    (( rc == 128 )) && return 128
    return 0
  fi

  (( rc == 0 && failNow )) && rc=1
  if (( rc == 0 && skipNow )); then
    printf '\r--- %s\t%s\t%s: %s\n' $SkipT $duration $testname "$reason_"
    SkipCountT+=1
    return 0
  fi

  TestCountT+=1
  case $rc in
    0 )
      printf $columns $PassT $duration $testname
      PassCountT+=1
      ;;
    128 ) printf $columns $FatalT $duration $testname; failed=1; return 128;;
    *   ) printf $columns $FailT $duration $YellowT$testname$ResetT; failed=1;;
  esac
}

# tesht.testFile runs any test functions in filename, or just functions whose
# names match runRegexp (bash =~ regex; empty = match all).
# It outputs success or failure.
# It returns an error result code if there was a failure.
#
# Exports TESHT_TEST_FILE (absolute path) so test bodies can locate adjacent
# scripts. Inside the eval'd test source, $BASH_SOURCE refers to the tesht
# binary, not the test file -- see "Script discovery" in docs/tesht.md.
#
# When jobs > 1 (#37833), tests within the file run concurrently across N
# background workers. Each worker captures its test's stdout+stderr to a
# per-test buffer and emits its TestCountT/PassCountT/failed deltas to a
# per-test counter file. After all workers complete, the parent serializes
# the per-test buffers in source-file order and accumulates the deltas, so
# the printed output and pass/fail counts match the serial path.
tesht.testFile() {
  local filename=$1 runRegexp_=${2:-}
  local -i jobs=${3:-1}

  local failed=0    # overall result -- fails if any individual run fails
  local testsInFile=( $(tesht.listTestnames $filename) )
  # Strip the file's own trailing `tesht.Main "$@"` boilerplate line (the
  # universal per-file entry-point convention every *_test.bash file ends
  # with) before capturing testSource_. tesht.test's `eval "$testSource_"`
  # re-evaluates this ENTIRE text once per individual test run; without
  # stripping, that trailing line fires for real on every eval, and "$@"
  # at that point is NOT the file's real invocation args -- eval doesn't
  # reset positional params, so it's still tesht.test's own
  # ($testSource_, $testname) pair. The stray call then runs tesht.Main
  # with the TEST NAME as a bogus "filenames" arg, producing a
  # harmless-but-alarming phantom `awk: fatal: cannot open file
  # 'test_foo'` + FAIL/0/0 line on EVERY test, in EVERY file, in every
  # project using tesht (confirmed via a two-line minimal repro). Stripping
  # the line at capture time (once per file, here) rather than guarding
  # tesht.Main itself keeps tests that deliberately invoke tesht.Main
  # directly with their own explicit args (e.g. tesht_test.bash's own
  # test_Main subtests) working unchanged -- only the literal, universal
  # trailing boilerplate line is ever removed.
  local testSource_=$(grep -v '^tesht\.Main "\$@"$' $filename)
  export TESHT_TEST_FILE=$(realpath -- $filename)

  if (( jobs <= 1 )); then
    for testname in ${testsInFile[@]}; do
      [[ -z $runRegexp_ || $testname =~ $runRegexp_ ]] && tesht.test "$testSource_" $testname
    done
    return $failed
  fi

  # Parallel path: filter, fan out across `jobs` workers, serialize results.
  local -a selectedTests=()
  for testname in ${testsInFile[@]}; do
    [[ -z $runRegexp_ || $testname =~ $runRegexp_ ]] && selectedTests+=( "$testname" )
  done
  (( ${#selectedTests[@]} == 0 )) && return 0

  local parDir_
  parDir_=$(mktemp -d /tmp/tesht.par.XXXXXX) && [[ -n $parDir_ ]] ||
    { echo 'tesht.testFile: could not create parallel-results directory' >&2; return 1; }
  local parDir=$parDir_
  tesht.Defer "tesht.Retry --attempts 5 --delay 0.2 --on-exhaust warn -- rm -rf -- $parDir"

  local -i idx
  for (( idx = 0; idx < ${#selectedTests[@]}; idx++ )); do
    # Throttle: keep at most `jobs` workers running concurrently. `jobs -pr`
    # lists running background PIDs; `wait -n` reaps any single one.
    while (( $(jobs -pr | wc -l) >= jobs )); do
      wait -n 2>/dev/null || true
    done
    (
      # Workers inherit the parent's EXIT trap (parDir-cleanup Defer). Reset
      # it so a worker exit doesn't rm -rf parDir out from under siblings.
      trap - EXIT
      local -i TestCountT=0 PassCountT=0 SkipCountT=0 failed=0
      tesht.test "$testSource_" ${selectedTests[idx]} >"$parDir/$idx.out" 2>&1 || true
      echo "$TestCountT $PassCountT $failed $SkipCountT" >"$parDir/$idx.cnt"
    ) &
  done
  wait

  local -i tc pc f sc
  for (( idx = 0; idx < ${#selectedTests[@]}; idx++ )); do
    cat -- "$parDir/$idx.out"
    tc=0; pc=0; f=0; sc=0
    IFS=' ' read -r tc pc f sc <"$parDir/$idx.cnt" || true
    TestCountT+=$tc
    PassCountT+=$pc
    SkipCountT+=$sc
    (( f )) && failed=1
  done

  return $failed
}

# tesht.testFiles runs the given files concurrently, at most fileJobs at a time.
# Each worker runs one file through tesht.testFile, capturing its stdout and
# stderr to per-file buffers and, from its EXIT trap, its counter deltas and exit
# status to a per-file counter file, so a worker that exits early still reports.
# After all workers finish, each file's stdout and stderr are replayed to fds 1
# and 2 in argument order and the deltas accumulated, so results, totals and exit
# code match the serial run; only wall-clock changes. A worker that left no
# counter file counts as a failure. It composes with -j: a worker's file may run
# its own tests across `jobs` workers (a worker starts with an empty job table).
# On INT, TERM or HUP it stops each worker's process group before exiting,
# and on return it restores the caller's own traps for those signals.
#
# Args: $1 = test-name regex filter; $2 = within-file jobs; $3 = file jobs;
#       $4... = test files.
tesht.testFiles() {
  local runRegexp_=$1
  local -i jobs=$2 fileJobs=$3
  local -a files=( "${@:4}" ) workers=()

  local parDir_
  parDir_=$(mktemp -d -t tesht.files.XXXXXX) && [[ -n $parDir_ ]] ||
    { echo 'tesht.testFiles: could not create results directory' >&2; return 1; }
  local parDir=$parDir_ quotedDir
  printf -v quotedDir '%q' $parDir
  # Restore the caller's own INT/TERM/HUP traps afterwards; tesht can be sourced.
  local callerTrapLines
  callerTrapLines=$(trap -p INT TERM HUP)
  local callerMonitor=+m
  [[ $- == *m* ]] && callerMonitor=-m
  # Only workers still running are stopped: a reaped worker's pid may belong to someone else now.
  trap 'tesht.stopGroups $(tesht.liveWorkers ${workers[*]}); rm -rf -- '$quotedDir'; exit 130' INT
  trap 'tesht.stopGroups $(tesht.liveWorkers ${workers[*]}); rm -rf -- '$quotedDir'; exit 143' TERM
  trap 'tesht.stopGroups $(tesht.liveWorkers ${workers[*]}); rm -rf -- '$quotedDir'; exit 129' HUP

  local -i idx
  for (( idx = 0; idx < ${#files[@]}; idx++ )); do
    while (( $(jobs -pr | wc -l) >= fileJobs )); do
      wait -n 2>/dev/null || true
    done
    # With job control on for the spawn, the worker leads its own process group, so
    # stopping it reaches every process its tests start, even ones reparented after
    # their parent died. The worker turns job control off at once, so its own -j
    # jobs and test processes stay in its group.
    set -m
    (
      set +m
      # A worker reports from its own EXIT trap and does not run the parent's.
      trap - INT TERM HUP
      # shellcheck disable=SC2030 # worker-local counters; their deltas return through the .cnt file
      local -i TestCountT=0 PassCountT=0 SkipCountT=0 failed=0 rc=0 workerPid=$BASHPID
      # The test subshells below inherit this trap; only the worker itself reports.
      trap 'st=$?; [[ $BASHPID != '$workerPid' ]] || { (( rc != 0 || st == 0 )) || { rc=$st; failed=1; }; echo "$TestCountT $PassCountT $failed $SkipCountT $rc" >'$quotedDir/$idx.cnt.tmp' && mv -- '$quotedDir/$idx.cnt.tmp' '$quotedDir/$idx.cnt'; }' EXIT
      tesht.testFile ${files[idx]} "$runRegexp_" $jobs >$parDir/$idx.out 2>$parDir/$idx.err && rc=$? || rc=$?
      (( rc == 0 )) || failed=1
    ) </dev/null &
    workers+=( $! )
    set $callerMonitor
  done
  wait
  # Through the replay, an interrupt only removes the results directory.
  trap 'rm -rf -- '$quotedDir'; exit 130' INT
  trap 'rm -rf -- '$quotedDir'; exit 143' TERM
  trap 'rm -rf -- '$quotedDir'; exit 129' HUP

  local -i tc pc f sc wrc failed=0
  local counts_=''
  # shellcheck disable=SC2031 # the parent's own counters; workers' copies were never meant to reach here
  for (( idx = 0; idx < ${#files[@]}; idx++ )); do
    cat -- $parDir/$idx.out 2>/dev/null || true
    cat -- $parDir/$idx.err >&2 2>/dev/null || true
    tc=0; pc=0; f=1; sc=0; wrc=1  # a worker that left no well-formed counts failed
    if counts_=$(tesht.workerCounts $parDir/$idx.cnt); then
      IFS=' ' read -r tc pc f sc wrc <<<"$counts_"
    fi
    TestCountT+=$tc
    PassCountT+=$pc
    SkipCountT+=$sc
    (( f || wrc != 0 )) && failed=1
  done
  rm -rf -- $parDir
  trap - INT TERM HUP
  [[ -z "$callerTrapLines" ]] || eval "$callerTrapLines"

  return $failed
}

# tesht.liveWorkers prints the given pids that are still running jobs of this shell.
tesht.liveWorkers() {
  local live_ pid
  live_=$(jobs -pr)
  for pid in "$@"; do
    grep -qx -- $pid <<<"$live_" && echo $pid
  done
  return 0
}

# tesht.workerCounts prints a worker's counter file when it holds exactly five
# non-negative integers, or fails.
tesht.workerCounts() {
  local file=$1 counts_
  [[ -f $file ]] && counts_=$(<$file) || return 1
  [[ "$counts_" =~ ^[0-9]+\ [0-9]+\ [0-9]+\ [0-9]+\ [0-9]+$ ]] || return 1
  echo "$counts_"
}

# tesht.stopGroups stops each worker and everything it started: TERM and CONT to
# each worker's process group (which catches children reparented after their
# parent died) and to every descendant found by walking the tree (which catches
# children that left the group), up to two seconds to exit, then KILL to what is
# left. It never signals tesht's own group, which may include tesht's caller. A
# process that both left its group and was reparented (a daemon) is out of reach.
tesht.stopGroups() {
  local -a groups=() tree=() found
  local pid
  for pid in "$@"; do
    kill -0 -- -$pid 2>/dev/null && groups+=( -$pid )
    mapfile -t found < <(tesht.descendants $pid)
    tree+=( ${found[@]+"${found[@]}"} )
  done
  (( ${#groups[@]} + ${#tree[@]} > 0 )) || return 0
  kill -TERM -- ${groups[@]} ${tree[@]} 2>/dev/null || true
  kill -CONT -- ${groups[@]} ${tree[@]} 2>/dev/null || true
  local -i try alive
  local target
  for (( try = 0; try < 20; try++ )); do
    alive=0
    for target in ${groups[@]} ${tree[@]}; do
      kill -0 -- $target 2>/dev/null && alive=1
    done
    (( alive )) || return 0
    sleep 0.1
  done
  kill -KILL -- ${groups[@]} ${tree[@]} 2>/dev/null || true
}

# tesht.descendants prints pid and all its descendants, depth first, reading each
# process's children from every one of its threads under /proc, or from ps where
# /proc is absent.
tesht.descendants() {
  local pid=$1 child
  echo $pid
  for child in $(tesht.childPids $pid); do
    tesht.descendants $child
  done
}

# tesht.childPids prints the pids of pid's children.
tesht.childPids() {
  local pid=$1
  if [[ -r /proc/$pid/task/$pid/children ]]; then
    local task=''  # noglob is on: read the thread list rather than globbing it
    while IFS= read -r task; do
      cat /proc/$pid/task/$task/children 2>/dev/null
    done < <(ls /proc/$pid/task 2>/dev/null) | tr ' ' '\n' | grep . || true
  else
    ps -A -o pid=,ppid= 2>/dev/null | awk -v p=$pid '$2 == p { print $1 }'
  fi
}

# tesht.UnixMilli returns the current time in Unix time as milliseconds.
tesht.UnixMilli() {
  local whole='' fraction=''
  # EPOCHREALTIME reports second fractions to nano precision
  IFS=. read -r whole fraction <<<$EPOCHREALTIME
  echo "$whole${fraction:0:3}"
}

# Parse command-line options + positionals. Flags can interleave with positional
# args; the loop classifies each arg per turn. `--` terminates flag parsing
# (everything after is positional, including args that start with `-`).
RunRegexpT_=''
FilenamesT=()
JobsT=1
FileJobsT=1
while (( $# )); do
  case $1 in
    -h|--help)  echo "$Usage_"; exit;;
    -x|--trace) set -x; shift;;
    --run)
      [[ ${2-} != -- ]] && (( $# >= 2 )) || { echo 'error: --run requires a regexp' >&2; exit 2; }
      RunRegexpT_=$2; shift 2
      ;;
    --run=*)    RunRegexpT_=${1#--run=}; shift;;
    -run|-run=*)  # obsolete-flag-reject-test
      echo 'error: -run was removed; use --run REGEXP' >&2; exit 2;;  # obsolete-flag-reject-test
    -j|--jobs)
      [[ ${2-} =~ ^[0-9]+$ ]] || { echo "error: $1 requires a non-negative integer" >&2; exit 2; }
      JobsT=$2; shift 2
      ;;
    -j=*)  # obsolete-flag-reject-test
      echo 'error: -j=N is not supported; use -j N or --jobs=N' >&2; exit 2;;  # obsolete-flag-reject-test
    -j?*)
      JobsT=${1#-j}
      [[ $JobsT =~ ^[0-9]+$ ]] || { echo "error: -j requires a non-negative integer, got: $JobsT" >&2; exit 2; }
      shift
      ;;
    --jobs=*)
      JobsT=${1#--jobs=}
      [[ $JobsT =~ ^[0-9]+$ ]] || { echo "error: --jobs requires a non-negative integer, got: $JobsT" >&2; exit 2; }
      shift
      ;;
    -p|--file-jobs)
      [[ ${2-} =~ ^[0-9]{1,4}$ ]] || { echo "error: $1 requires a non-negative integer below 10000, got: ${2-}" >&2; exit 2; }
      FileJobsT=$(( 10#$2 )); shift 2
      ;;
    -p=*)
      echo 'error: -p=N is not supported; use -p N or --file-jobs=N' >&2; exit 2;;
    -p?*)
      FileJobsT=${1#-p}
      [[ $FileJobsT =~ ^[0-9]{1,4}$ ]] || { echo "error: -p requires a non-negative integer below 10000, got: $FileJobsT" >&2; exit 2; }
      FileJobsT=$(( 10#$FileJobsT ))
      shift
      ;;
    --file-jobs=*)
      FileJobsT=${1#--file-jobs=}
      [[ $FileJobsT =~ ^[0-9]{1,4}$ ]] || { echo "error: --file-jobs requires a non-negative integer below 10000, got: $FileJobsT" >&2; exit 2; }
      FileJobsT=$(( 10#$FileJobsT ))
      shift
      ;;
    --)         shift; FilenamesT+=( "$@" ); break;;
    -*)         echo "error: unknown option: $1" >&2; exit 2;;
    *)          FilenamesT+=( "$1" ); shift;;
  esac
done
(( JobsT > 0 )) || JobsT=1   # treat -j 0 as serial (defensive)
(( FileJobsT > 0 )) || FileJobsT=1   # and -p 0

# Inverted file-look guard — 4-branch table:
#   directory -> expand to shallow *_test.bash files (branch 1)
#   on-disk file -> accept (branch 2; matches _test.bash or operator named a real file)
#   ends in _test.bash AND not on disk -> file-not-found error (branch 3)
#   anything else -> did-you-mean error (branch 4)
ExpandedFilesT=()
for arg in "${FilenamesT[@]+"${FilenamesT[@]}"}"; do
  if [[ -d $arg ]]; then
    set +o noglob; shopt -s nullglob
    dirFilesT=( "$arg"/*_test.bash )
    shopt -u nullglob; set -o noglob
    (( ${#dirFilesT[@]} > 0 )) || {
      echo "error: no *_test.bash files in directory: $arg" >&2
      exit 2
    }
    ExpandedFilesT+=( "${dirFilesT[@]}" )
  elif [[ -f $arg ]]; then
    ExpandedFilesT+=( "$arg" )
  elif [[ $arg == *_test.bash ]]; then
    echo "error: file not found: $arg" >&2
    exit 2
  else
    echo "error: '$arg' does not look like a test file or directory; did you mean: $Prog --run $arg, $Prog <dir>, or $Prog <dir>/*_test.bash?" >&2
    exit 2
  fi
done
FilenamesT=( "${ExpandedFilesT[@]+"${ExpandedFilesT[@]}"}" )

# If no files specified, use all test files in cwd.
if (( ${#FilenamesT[@]} == 0 )); then
  set +o noglob; shopt -s nullglob
  FilenamesT=( *_test.bash )
  shopt -u nullglob; set -o noglob
  (( ${#FilenamesT[@]} == 0 )) && { echo 'no test files found'; exit; }
fi

# strict mode
return 2>/dev/null
set -euf

tesht.Main "$RunRegexpT_" "$(tesht.ListOf "${FilenamesT[@]}")" $JobsT $FileJobsT
